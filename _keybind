#compdef keybind

# Completion for keybind from zsh-named-keybind.

local offset=1 first expl
local -a keys keymaps widgets options

# Key names match case-insensitively, and - matches +.
local key_matcher='m:{a-zA-Z-}={A-Za-z+}'

if [[ $words[2] == -M ]]; then
  if (( CURRENT == 3 )); then
    keymaps=(${(f)"$(bindkey -l)"})
    _wanted keymaps expl keymap compadd -a keymaps
    return
  fi
  offset=3
fi

first=$words[offset+1]

_named_keybind_complete_keys() {
  # Inside a quoted chord, complete the element after the last space.
  compset -P '* '
  _named_keybind_candidates
  keys=("$reply[@]")
  _wanted keys expl 'key name' compadd -M "$key_matcher" -a keys
}

if (( CURRENT == offset + 1 )); then
  options=(
    '-l:list named bindings'
    '-k:identify a key press'
    '-r:remove bindings'
  )
  (( offset == 1 )) && options+=('-M:select a keymap')
  widgets=(${(f)"$(zle -la)"})
  _alternative \
    'options:option:_describe -t options option options' \
    'widgets:widget:compadd -a widgets' \
    'keys:key name:_named_keybind_complete_keys'
  return
fi

case $first in
  -l|-k) return 1 ;;
  *) _named_keybind_complete_keys ;;
esac
